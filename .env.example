# Path to the QSpice executable. On Windows typical install:
#   C:\Program Files\QSPICE\QSPICE64.exe
# On Linux via Wine:
#   /home/you/.wine/drive_c/Program Files/QSPICE/QSPICE64.exe
QSPICE_EXE=C:\Program Files\QSPICE\QSPICE64.exe

# Workspace root for schematics and derived artifacts. Defaults to the current
# working directory. The MCP launcher usually sets this via --workspace-root.
# QSPICE_WORKSPACE_ROOT=

# Cache directory for simulation outputs. Defaults to the per-user cache dir.
# QSPICE_CACHE_DIR=

# Logging level: debug, info, warning, or error (lowercase).
QSPICE_LOG_LEVEL=info

# Default simulation timeout in seconds (applies when a tool omits timeout_s).
# Set to 0 to disable the default timeout.
QSPICE_TIMEOUT_S=120

# Optional simulation artifact cache byte cap (LRU eviction). Omit for unlimited.
# QSPICE_MAX_CACHE_BYTES=536870912

# Optional transport for future SSE hosting experiments (default: stdio).
# QSPICE_TRANSPORT=stdio

# Optional: launch QSpice during server startup for faster first simulation.
# QSPICE_INITIALIZE_QSPICE_ON_STARTUP=false

# Optional live-GUI bridge command tokens (space-separated executable + args).
# QSPICE_LIVE_GUI_BRIDGE_COMMAND=

# Optional: enable request-scoped OpenTelemetry spans for long-running tools.
# Requires the [telemetry] extra plus an in-process tracer provider/exporter
# configured before the server starts.
QSPICE_TELEMETRY_ENABLED=false
